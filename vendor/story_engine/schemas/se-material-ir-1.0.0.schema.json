{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-material-ir/1.0.0",
  "title": "Material IR 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "story_pack_ref", "story_pack_version", "default_locale", "locales", "digest_policy", "assets", "reference_index", "materials", "coverage", "source_sha256", "coverage_sha256", "material_ir_sha256"],
  "properties": {
    "schema": {"const": "se-material-ir/1.0.0"},
    "story_pack_ref": {"$ref": "#/$defs/ref"},
    "story_pack_version": {"$ref": "#/$defs/ref"},
    "default_locale": {"$ref": "#/$defs/locale"},
    "locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/locale"}},
    "digest_policy": {"const": "sha256-canonical-json/1"},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "reference_index": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "materials": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/material"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "source_sha256": {"$ref": "#/$defs/digest"},
    "coverage_sha256": {"$ref": "#/$defs/digest"},
    "material_ir_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 200},
    "locale": {"type": "string", "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{2,8})*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_ref", "path", "digest"],
      "properties": {"asset_ref": {"$ref": "#/$defs/ref"}, "path": {"type": "string", "minLength": 1, "maxLength": 240}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "kind", "audience", "required"],
      "properties": {"ref": {"$ref": "#/$defs/ref"}, "kind": {"$ref": "#/$defs/ref"}, "audience": {"enum": ["public", "player", "room_host", "deployment_owner", "author_offline"]}, "required": {"type": "boolean"}}
    },
    "span": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"enum": ["text", "strong", "emphasis", "code"]}, "text": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "text", "target"], "properties": {"kind": {"const": "link"}, "text": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}}}
      ]
    },
    "rich": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/span"}},
    "block": {
      "type": "object",
      "required": ["block_ref", "sequence", "kind"],
      "properties": {
        "block_ref": {"$ref": "#/$defs/ref"}, "sequence": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["heading", "paragraph", "list", "table", "quote", "code", "image"]},
        "level": {"type": "integer", "minimum": 1, "maximum": 6}, "spans": {"$ref": "#/$defs/rich"},
        "text": {"type": "string", "minLength": 1}, "ordered": {"type": "boolean"},
        "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["spans", "text"], "additionalProperties": false, "properties": {"spans": {"$ref": "#/$defs/rich"}, "text": {"type": "string", "minLength": 1}}}},
        "language": {"type": "string", "minLength": 1}, "headers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
        "text_alternative": {"type": "string", "minLength": 1}, "alt": {"type": "string", "minLength": 1}, "asset_ref": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "heading"}}}, "then": {"required": ["level", "spans", "text"]}},
        {"if": {"properties": {"kind": {"enum": ["paragraph", "quote"]}}}, "then": {"required": ["spans", "text"]}},
        {"if": {"properties": {"kind": {"const": "list"}}}, "then": {"required": ["ordered", "items"]}},
        {"if": {"properties": {"kind": {"const": "code"}}}, "then": {"required": ["language", "text"]}},
        {"if": {"properties": {"kind": {"const": "image"}}}, "then": {"required": ["alt", "asset_ref"]}},
        {"if": {"properties": {"kind": {"const": "table"}}}, "then": {"required": ["headers", "rows", "text_alternative"]}}
      ],
      "additionalProperties": false
    },
    "material": {
      "type": "object", "additionalProperties": false,
      "required": ["material_id", "section_id", "material_type", "locale", "audience", "spoiler_class", "title", "summary", "body_sha256", "blocks", "source_refs", "related_material_ids", "display_purposes", "search_terms", "order", "required", "fallback_locale", "version"],
      "properties": {
        "material_id": {"$ref": "#/$defs/ref"}, "section_id": {"$ref": "#/$defs/ref"}, "material_type": {"enum": ["catalog", "player_guide", "mechanics", "room_host_guide", "owner_story", "reference", "faq", "operations"]},
        "locale": {"$ref": "#/$defs/locale"}, "audience": {"enum": ["public", "player", "room_host", "deployment_owner", "author_offline"]},
        "spoiler_class": {"enum": ["none", "mechanics", "progressive", "full_story", "author_internal"]},
        "title": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1},
        "body_sha256": {"$ref": "#/$defs/digest"}, "blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "related_material_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "display_purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["catalog", "guide", "mechanics", "story", "search", "readme", "qq_help"]}}, "search_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "order": {"type": "integer", "minimum": 0}, "required": {"type": "boolean"}, "fallback_locale": {"type": ["string", "null"]}, "version": {"$ref": "#/$defs/ref"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "expected", "records", "extra", "missing"],
      "properties": {
        "schema": {"const": "documentation-coverage/1.0.0"}, "expected": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "records": {"type": "array", "items": {"$ref": "#/$defs/coverageRecord"}}, "extra": {"type": "array", "maxItems": 0}, "missing": {"type": "array", "maxItems": 0}
      }
    },
    "coverageRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["ref", "status", "material_ids"],
      "properties": {"ref": {"$ref": "#/$defs/ref"}, "status": {"enum": ["documented", "intentionally_internal", "not_applicable"]}, "material_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}}
    }
  }
}
