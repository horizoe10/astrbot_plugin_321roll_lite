{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-story-flow-ir/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "recipe_ref", "recipe_version", "source_schema", "source_sha256", "reference_catalog_sha256", "source_map", "required_capabilities", "optional_capabilities", "entry_phase_ref", "phase_nodes", "transitions", "cycle_guards", "ending_modes", "absence_defaults", "public_summary", "graph_summary", "runtime_slice_sha256", "ir_sha256"],
  "properties": {
    "schema": {"const": "se-story-flow-ir/1.0.0"},
    "recipe_ref": {"$ref": "#/$defs/ref"}, "recipe_version": {"$ref": "#/$defs/ref"},
    "source_schema": {"const": "story-flow-recipe/1.0.0"}, "source_sha256": {"$ref": "#/$defs/digest"},
    "reference_catalog_sha256": {"$ref": "#/$defs/digest"},
    "source_map": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["ir_ref", "source_path"], "properties": {"ir_ref": {"$ref": "#/$defs/ref"}, "source_path": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^\\$"}}}},
    "required_capabilities": {"$ref": "#/$defs/refs"}, "optional_capabilities": {"$ref": "#/$defs/refs"},
    "entry_phase_ref": {"$ref": "#/$defs/ref"},
    "phase_nodes": {"type": "array", "minItems": 1, "items": {"$ref": "se-story-flow-recipe-1.0.0.schema.json#/$defs/phase"}},
    "transitions": {"type": "array", "minItems": 1, "items": {"$ref": "se-story-flow-recipe-1.0.0.schema.json#/$defs/transition"}},
    "cycle_guards": {"type": "array", "items": {"$ref": "se-story-flow-recipe-1.0.0.schema.json#/$defs/cycle_guard"}},
    "ending_modes": {"type": "array", "minItems": 1, "items": {"$ref": "se-story-flow-recipe-1.0.0.schema.json#/$defs/ending"}},
    "absence_defaults": {"$ref": "se-story-flow-recipe-1.0.0.schema.json#/$defs/absence"},
    "public_summary": {"type": "string", "minLength": 1, "maxLength": 600, "pattern": "\\S"},
    "graph_summary": {"type": "object", "additionalProperties": false, "required": ["phase_count", "transition_count", "reachable_phase_refs", "cyclic_transition_refs", "terminal_phase_refs"], "properties": {"phase_count": {"type": "integer", "minimum": 1}, "transition_count": {"type": "integer", "minimum": 1}, "reachable_phase_refs": {"$ref": "#/$defs/refs"}, "cyclic_transition_refs": {"$ref": "#/$defs/refs"}, "terminal_phase_refs": {"$ref": "#/$defs/refs"}}},
    "runtime_slice_sha256": {"$ref": "#/$defs/digest"}, "ir_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"},
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
