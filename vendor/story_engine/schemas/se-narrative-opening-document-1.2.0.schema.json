{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "opening_ref",
    "blocks",
    "paragraph_count",
    "outside_target_count",
    "hard_limit_violations",
    "document_sha256"
  ],
  "properties": {
    "schema": {
      "const": "se-narrative-opening-document/1.2.0"
    },
    "opening_ref": {
      "$ref": "#/$defs/ref"
    },
    "blocks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/referenced_block"
      }
    },
    "paragraph_count": {
      "type": "integer",
      "minimum": 2
    },
    "outside_target_count": {
      "type": "integer",
      "minimum": 0
    },
    "hard_limit_violations": {
      "const": 0
    },
    "document_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-narrative-opening-document/1.2.0",
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "audience": {
      "enum": [
        "public",
        "party",
        "actor",
        "dm",
        "admin",
        "author"
      ]
    },
    "referenced_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_ref",
        "kind",
        "order",
        "locale",
        "audience",
        "source_ref",
        "text",
        "text_digest",
        "references",
        "speaker",
        "reference_status"
      ],
      "properties": {
        "block_ref": {
          "$ref": "#/$defs/ref"
        },
        "kind": {
          "enum": [
            "paragraph",
            "npc_dialogue",
            "npc_action"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "text_digest": {
          "$ref": "#/$defs/digest"
        },
        "references": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "source_ref",
              "label",
              "start",
              "end",
              "kind"
            ],
            "properties": {
              "schema": {
                "const": "se-authored-entity-reference/1.0.0"
              },
              "source_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "person",
                  "place",
                  "quest",
                  "status"
                ]
              }
            }
          }
        },
        "speaker": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema",
                "source_ref",
                "label",
                "kind"
              ],
              "properties": {
                "schema": {
                  "const": "se-authored-speaker/1.0.0"
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "kind": {
                  "const": "person"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_status": {
          "enum": [
            "none",
            "resolved"
          ]
        }
      }
    }
  }
}
