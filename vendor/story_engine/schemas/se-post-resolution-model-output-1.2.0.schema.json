{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://story-engine.local/schemas/se-post-resolution-model-output/1.2.0",
  "title": "Ordered post-resolution model output with NPC actions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocks",
    "proposals",
    "option_copy",
    "used_fact_refs",
    "used_receipt_refs",
    "used_capability_refs",
    "warnings",
    "annotations"
  ],
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "paragraph",
              "dialogue",
              "heading",
              "aside"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200,
            "pattern": "^[^\\r\\n]+$",
            "description": "One paragraph without line breaks; the engine accepts at most 360 non-whitespace characters per block."
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 0
    },
    "option_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "no_options",
            "frozen_options"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "local_ref",
              "text"
            ],
            "properties": {
              "local_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "used_fact_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "used_receipt_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "used_capability_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "base.narrative",
          "narrative.structured_output"
        ]
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "annotations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "kind",
          "speaker",
          "mentions"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "kind": {
            "enum": [
              "paragraph",
              "npc_dialogue",
              "npc_action"
            ]
          },
          "speaker": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "entity_ref",
                  "label"
                ],
                "properties": {
                  "entity_ref": {
                    "type": "string",
                    "pattern": "^entity\\.[a-f0-9]{64}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "mentions": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entity_ref",
                "label",
                "start",
                "end"
              ],
              "properties": {
                "entity_ref": {
                  "type": "string",
                  "pattern": "^entity\\.[a-f0-9]{64}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
