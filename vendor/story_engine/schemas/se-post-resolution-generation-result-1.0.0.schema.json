{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "se-post-resolution-generation-result/1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "operation_ref", "request_fingerprint", "receipt_ref", "receipt_sha256", "committed_revision", "audience_ref", "snapshot_fingerprint", "call_sequence", "narrative_document", "proposals", "option_copy", "used_fact_refs", "used_receipt_refs", "used_capability_refs", "warnings"],
  "properties": {
    "schema": {"const": "se-post-resolution-generation-result/1.0.0"}, "operation_ref": {"$ref": "#/$defs/ref"}, "request_fingerprint": {"$ref": "#/$defs/digest"},
    "receipt_ref": {"$ref": "#/$defs/ref"}, "receipt_sha256": {"$ref": "#/$defs/digest"}, "committed_revision": {"type": "integer", "minimum": 1}, "audience_ref": {"$ref": "#/$defs/ref"},
    "snapshot_fingerprint": {"$ref": "#/$defs/digest"}, "call_sequence": {"const": 1},
    "narrative_document": {"$ref": "#/$defs/narrativeDocument"},
    "proposals": {"type": "array", "maxItems": 64, "items": {"oneOf": [{"$ref": "#/$defs/factProposal"}, {"$ref": "#/$defs/eventProposal"}]}},
    "option_copy": {"type": "object", "additionalProperties": false, "required": ["status", "items"], "properties": {"status": {"enum": ["frozen_options", "no_options"]}, "items": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["local_ref", "text"], "properties": {"local_ref": {"$ref": "#/$defs/ref"}, "text": {"type": "string", "minLength": 1, "maxLength": 240}}}}}},
    "used_fact_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "used_receipt_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "used_capability_refs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["base.narrative", "narrative.structured_output"]}, "allOf": [{"contains": {"const": "base.narrative"}}, {"contains": {"const": "narrative.structured_output"}}]}, "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dependencyRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "narrativeBlock": {"type": "object", "additionalProperties": false, "required": ["block_ref", "sequence", "kind", "text"], "properties": {"block_ref": {"$ref": "#/$defs/ref"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 64}, "kind": {"enum": ["paragraph", "dialogue", "heading", "aside"]}, "text": {"type": "string", "minLength": 1, "maxLength": 360, "pattern": "^[^\\r\\n]+$"}}, "allOf": [{"if": {"properties": {"kind": {"const": "heading"}}}, "then": {"properties": {"text": {"maxLength": 120}}}}]},
    "narrativeDocument": {"type": "object", "additionalProperties": false, "required": ["blocks", "fact_refs", "receipt_refs", "policy_ref", "policy_sha256", "narrative_digest"], "properties": {"blocks": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/narrativeBlock"}}, "fact_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "receipt_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "policy_ref": {"$ref": "#/$defs/ref"}, "policy_sha256": {"$ref": "#/$defs/digest"}, "narrative_digest": {"$ref": "#/$defs/digest"}}},
    "factProposal": {"type": "object", "additionalProperties": false, "required": ["type", "local_ref", "fact_type", "value", "dependency_refs"], "properties": {"type": {"const": "fact_proposal"}, "local_ref": {"$ref": "#/$defs/ref"}, "fact_type": {"$ref": "#/$defs/ref"}, "value": {"type": ["null", "string", "number", "boolean"], "maxLength": 4096}, "dependency_refs": {"$ref": "#/$defs/dependencyRefs"}}},
    "eventProposal": {"type": "object", "additionalProperties": false, "required": ["type", "local_ref", "event_kind", "payload", "dependency_refs"], "properties": {"type": {"const": "event_proposal"}, "local_ref": {"$ref": "#/$defs/ref"}, "event_kind": {"$ref": "#/$defs/ref"}, "payload": {"type": "object", "maxProperties": 64, "propertyNames": {"not": {"enum": ["stable_id", "authority", "commit", "platform_commit"]}}, "additionalProperties": true}, "dependency_refs": {"$ref": "#/$defs/dependencyRefs"}}}
  }
}
