{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "se-condition-tree/1.0.0",
  "oneOf": [{"$ref": "#/$defs/compare"}, {"$ref": "#/$defs/group"}, {"$ref": "#/$defs/not"}],
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "compare": {"type": "object", "additionalProperties": false, "required": ["op", "fact_ref", "value"], "properties": {"op": {"enum": ["eq", "ne", "lt", "lte", "gt", "gte", "contains", "not_contains"]}, "fact_ref": {"$ref": "#/$defs/ref"}, "value": {"oneOf": [{"type": "boolean"}, {"type": "integer"}, {"$ref": "#/$defs/ref"}, {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}]}}},
    "group": {"type": "object", "additionalProperties": false, "required": ["op", "args"], "properties": {"op": {"enum": ["all", "any"]}, "args": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"oneOf": [{"$ref": "#/$defs/compare"}, {"$ref": "#/$defs/group"}, {"$ref": "#/$defs/not"}]}}}},
    "not": {"type": "object", "additionalProperties": false, "required": ["op", "arg"], "properties": {"op": {"const": "not"}, "arg": {"oneOf": [{"$ref": "#/$defs/compare"}, {"$ref": "#/$defs/group"}, {"$ref": "#/$defs/not"}]}}}
  }
}
