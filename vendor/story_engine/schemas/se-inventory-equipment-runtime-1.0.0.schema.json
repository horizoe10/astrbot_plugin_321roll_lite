        "privateMerge":{"allOf":[{"$ref":"#/$defs/basePrivate"},{"type":"object","required":["operation","target_instance_ref","source_quantity","target_quantity","merged_quantity","remove_source_after_commit"],"properties":{"operation":{"const":"merge"},"target_instance_ref":{"$ref":"#/$defs/ref"},"source_quantity":{"type":"integer","minimum":1},"target_quantity":{"type":"integer","minimum":1},"merged_quantity":{"type":"integer","minimum":2},"remove_source_after_commit":{"const":true}}}],"unevaluatedProperties":false},
        "privateEquip":{"allOf":[{"$ref":"#/$defs/basePrivate"},{"type":"object","required":["operation","slot","expected_slot_instance_ref"],"properties":{"operation":{"const":"equip"},"slot":{"enum":["body","main_hand","utility"]},"expected_slot_instance_ref":{"oneOf":[{"$ref":"#/$defs/ref"},{"type":"null"}]}}}],"unevaluatedProperties":false},
        "privateUnequip":{"allOf":[{"$ref":"#/$defs/basePrivate"},{"type":"object","required":["operation","slot"],"properties":{"operation":{"const":"unequip"},"slot":{"enum":["body","main_hand","utility"]}}}],"unevaluatedProperties":false},
        "privateDrop":{"allOf":[{"$ref":"#/$defs/basePrivate"},{"type":"object","required":["operation","quantity","physical_visibility_preserved"],"properties":{"operation":{"const":"drop"},"quantity":{"type":"integer","minimum":1},"physical_visibility_preserved":{"const":true}}}],"unevaluatedProperties":false},
        "privateEffect":{"allOf":[{"$ref":"#/$defs/basePrivate"},{"type":"object","required":["operation","effect","target_ref","target_kind","set_durability","atomic_effect_and_cost"],"properties":{"operation":{"const":"use"},"effect":{"type":"object","additionalProperties":false,"required":["kind","target_kinds","effect","failure_effect","durability_cost"],"properties":{"kind":{"enum":["aid","guard","interact","maneuver","parley"]},"target_kinds":{"type":"array","uniqueItems":true,"items":{"enum":["actor","objective","zone"]}},"effect":{"type":"string"},"failure_effect":{"type":"string"},"durability_cost":{"const":1}}},"target_ref":{"$ref":"#/$defs/ref"},"target_kind":{"enum":["actor","objective","zone"]},"set_durability":{"type":"integer","minimum":0},"atomic_effect_and_cost":{"const":true}}}],"unevaluatedProperties":false},
