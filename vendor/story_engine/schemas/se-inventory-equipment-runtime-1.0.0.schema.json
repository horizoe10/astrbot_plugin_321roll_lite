        "causeReceipt": {"type":"object","additionalProperties":false,"required":["schema","receipt_ref","cause_ref","room_ref","actor_ref","inventory_ref","room_revision","actor_revision","inventory_revision","dedupe_key","committed","fingerprint"],"properties":{"schema":{"const":"platform-inventory-cause-receipt/1.0.0"},"receipt_ref":{"$ref":"#/$defs/ref"},"cause_ref":{"$ref":"#/$defs/ref"},"room_ref":{"$ref":"#/$defs/ref"},"actor_ref":{"$ref":"#/$defs/ref"},"inventory_ref":{"$ref":"#/$defs/ref"},"room_revision":{"$ref":"#/$defs/rev"},"actor_revision":{"$ref":"#/$defs/rev"},"inventory_revision":{"$ref":"#/$defs/rev"},"dedupe_key":{"$ref":"#/$defs/ref"},"committed":{"const":true},"fingerprint":{"$ref":"#/$defs/hash"}}},
