      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "offer_ref": {
