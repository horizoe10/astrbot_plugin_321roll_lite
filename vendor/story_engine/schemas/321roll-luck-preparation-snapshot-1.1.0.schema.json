{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "321roll-luck-preparation-snapshot/1.1.0",
  "description": "平台为一次掷前机运准备冻结的严格输入。机运规则、代价配方、D20 规则定义与作者五带都必须来自房间固定的实际工件，本对象只按引用选择；任何人都不能在此自造 recipe。省略 prepared_choices 时只做预览，给出 prepared_choices 时按本人掷前已选方案集合产出窗口候选。snapshot_sha256 = canonical_fingerprint(去掉自身字段的规范化 JSON)。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_ref",
    "artifact_ref",
    "artifact_sha256",
    "offer_ref",
    "offer_sha256",
    "state",
    "rule_definition",
    "result_bands",
    "modifier",
    "difficulty",
    "recipe_bindings",
    "snapshot_sha256"
  ],
