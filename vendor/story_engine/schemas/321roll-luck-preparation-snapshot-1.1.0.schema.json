      "const": "321roll-luck-preparation-snapshot/1.1.0"
    },
    "operation_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"
    },
    "artifact_ref": {
      "description": "房间固定的实际工件引用；Engine 只通过授权桥读取该工件。",
