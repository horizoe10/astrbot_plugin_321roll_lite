{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-story-artifact/1.0.0",
  "title": "SE 1 Runtime Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engine_spec", "target_abi", "package", "canonical_ir_sha256", "compiler_contract_fingerprint", "content_sha256", "event_compositions", "capability_closure", "source_map", "projection_plan", "diagnostics_summary", "artifact_sha256"],
  "properties": {
    "schema": {"const": "se-story-artifact/1.0.0"},
    "engine_spec": {"const": "1.0.0"},
    "target_abi": {"const": "se-compiler/1.0.0"},
    "package": {"type": "object", "additionalProperties": false, "required": ["package_id", "content_version"], "properties": {"package_id": {"type": "string"}, "content_version": {"type": "string"}}},
    "canonical_ir_sha256": {"$ref": "#/$defs/hash"},
    "compiler_contract_fingerprint": {"$ref": "#/$defs/hash"},
    "content_sha256": {"$ref": "#/$defs/hash"},
    "event_compositions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "capability_closure": {"type": "object"},
    "source_map": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["output_path", "source_path", "field_path"], "properties": {"output_path": {"type": "string"}, "source_path": {"type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$"}, "field_path": {"type": "string"}}}},
    "projection_plan": {"type": "object", "additionalProperties": false, "required": ["kind", "execution_owner", "projection_owner"], "properties": {"kind": {"const": "bounded_proposal_only"}, "execution_owner": {"const": "321_platform"}, "projection_owner": {"const": "321_platform"}}},
    "diagnostics_summary": {"type": "object", "additionalProperties": false, "required": ["warnings", "errors"], "properties": {"warnings": {"type": "integer", "minimum": 0}, "errors": {"const": 0}}},
    "artifact_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
