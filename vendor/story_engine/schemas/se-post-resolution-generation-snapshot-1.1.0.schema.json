{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://321roll.local/contracts/post-resolution-generation-snapshot/1.1.0",
  "title": "321 Roll Post Resolution Generation Snapshot 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_ref", "request_fingerprint", "idempotency_key", "deadline_at", "story_pack_ref", "artifact_ref", "artifact_sha256", "canonical_sha256", "mechanical_receipt", "committed_revision", "audience_ref", "committed_facts", "legal_option_mode", "legal_option_intents", "narrative_policy", "story_pack_slice", "required_capability_refs", "snapshot_fingerprint"],
  "properties": {
    "schema": {"const": "321roll-post-resolution-generation-snapshot/1.1.0"},
    "operation_ref": {"$ref": "#/$defs/ref"},
    "request_fingerprint": {"$ref": "#/$defs/digest"},
    "idempotency_key": {"$ref": "#/$defs/ref"},
    "deadline_at": {"type": "string", "format": "date-time", "minLength": 1},
    "story_pack_ref": {"$ref": "#/$defs/ref"},
    "artifact_ref": {"$ref": "#/$defs/ref"},
    "artifact_sha256": {"$ref": "#/$defs/digest"},
    "canonical_sha256": {"$ref": "#/$defs/digest"},
    "mechanical_receipt": {"$ref": "#/$defs/mechanicalReceipt"},
    "committed_revision": {"$ref": "#/$defs/revision"},
    "audience_ref": {"$ref": "#/$defs/ref"},
    "committed_facts": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/committedFact"}},
    "legal_option_mode": {"enum": ["frozen_options", "no_options"]},
    "legal_option_intents": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/legalIntent"}},
    "narrative_policy": {"$ref": "#/$defs/narrativePolicy"},
    "story_pack_slice": {"$ref": "#/$defs/storyPackSlice"},
    "required_capability_refs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}, "allOf": [{"contains": {"const": "base.narrative"}}, {"contains": {"const": "narrative.structured_output"}}]},
    "snapshot_fingerprint": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "revision": {"type": "integer", "minimum": 1},
    "mechanicalReceipt": {"type": "object", "additionalProperties": false, "required": ["receipt_ref", "receipt_sha256", "committed_revision", "outcome", "degree", "result_band", "resolution_rule_ref", "natural_face", "margin", "modifier_receipt_refs"], "properties": {"receipt_ref": {"$ref": "#/$defs/ref"}, "receipt_sha256": {"$ref": "#/$defs/digest"}, "committed_revision": {"$ref": "#/$defs/revision"}, "outcome": {"$ref": "#/$defs/ref"}, "degree": {"$ref": "#/$defs/ref"}, "result_band": {"$ref": "#/$defs/ref"}, "resolution_rule_ref": {"$ref": "#/$defs/ref"}, "natural_face": {"type": "integer", "minimum": 1, "maximum": 20}, "margin": {"type": "integer"}, "modifier_receipt_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}}},
    "committedFact": {"type": "object", "additionalProperties": false, "required": ["fact_ref", "value"], "properties": {"fact_ref": {"$ref": "#/$defs/ref"}, "value": {"type": ["null", "string", "number", "boolean"], "maxLength": 240}}},
    "legalIntent": {"type": "object", "additionalProperties": false, "required": ["local_ref", "actor_ref", "route_ref", "purpose", "result_dependency_refs"], "properties": {"local_ref": {"$ref": "#/$defs/ref"}, "actor_ref": {"$ref": "#/$defs/ref"}, "route_ref": {"$ref": "#/$defs/ref"}, "purpose": {"$ref": "#/$defs/ref"}, "result_dependency_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}}},
    "narrativePolicy": {"type": "object", "additionalProperties": false, "required": ["policy_ref", "policy_sha256", "instruction", "world_voice"], "properties": {"policy_ref": {"$ref": "#/$defs/ref"}, "policy_sha256": {"$ref": "#/$defs/digest"}, "instruction": {"type": "string", "minLength": 1, "maxLength": 4096}, "world_voice": {"type": "string", "minLength": 1, "maxLength": 4096}}},
    "storyPackSlice": {"type": "object", "additionalProperties": false, "required": ["slice_ref", "slice_sha256", "content"], "properties": {"slice_ref": {"$ref": "#/$defs/ref"}, "slice_sha256": {"$ref": "#/$defs/digest"}, "content": {"$ref": "#/$defs/storyPackContent"}}},
    "storyPackContent": {"type": "object", "additionalProperties": false, "required": ["scene_ref", "narrative_constraints"], "properties": {"scene_ref": {"$ref": "#/$defs/ref"}, "narrative_constraints": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 240}}}}
  }
}
