{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-player-turn-input/1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "expected_interaction_revision",
    "references"
  ],
  "properties": {
    "schema": {
      "const": "se-player-turn-input/1.1.0"
    },
    "kind": {
      "enum": [
        "choice",
        "dialogue",
        "hybrid"
      ]
    },
    "expected_interaction_revision": {
      "type": "integer",
      "minimum": 0
    },
    "choice_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "utterance": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    },
    "locale": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "client_input_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "references": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_ref",
          "kind",
          "label",
          "description",
          "source_receipt_refs",
          "start",
          "end"
        ],
        "properties": {
          "entity_ref": {
            "type": "string",
            "pattern": "^entity\\.[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "person",
              "place",
              "item",
              "quest",
              "ability",
              "status"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "source_receipt_refs": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "choice"
          }
        }
      },
      "then": {
        "required": [
          "choice_ref"
        ],
        "properties": {
          "choice_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "utterance": {
            "type": "null"
          },
          "references": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dialogue"
          }
        }
      },
      "then": {
        "required": [
          "utterance"
        ],
        "properties": {
          "utterance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "choice_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hybrid"
          }
        }
      },
      "then": {
        "required": [
          "choice_ref"
        ],
        "properties": {
          "choice_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "references": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "utterance"
        ],
        "properties": {
          "utterance": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      }
    }
  ]
}
