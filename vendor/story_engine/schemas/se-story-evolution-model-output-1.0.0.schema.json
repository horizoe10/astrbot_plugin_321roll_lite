{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-story-evolution-model-output/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "dependency_edges", "narrative_dependency_refs", "warnings", "unused_reason"],
  "properties": {
    "items": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/item"}},
    "dependency_edges": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["from_local_ref", "to_local_ref"], "properties": {"from_local_ref": {"$ref": "#/$defs/local_ref"}, "to_local_ref": {"$ref": "#/$defs/local_ref"}}}},
    "narrative_dependency_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local_ref"}},
    "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "unused_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 240}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,199}$"},
    "local_ref": {"type": "string", "pattern": "^local\\.[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_local_ref", "type", "priority", "audience", "source_refs", "depends_on", "payload"],
      "properties": {
        "proposal_local_ref": {"$ref": "#/$defs/local_ref"},
        "type": {"enum": ["static_anchor.suggest", "static_module.suggest", "character_reaction.suggest", "narrative_focus.suggest", "story_thread.open", "story_thread.transition", "local_truth.freeze", "evidence.extend", "future_direction.offer", "dynamic_scene.propose", "dynamic_actor.propose", "dynamic_graph_node.propose", "dynamic_graph_edge.propose"]},
        "priority": {"enum": ["P0", "P1"]},
        "audience": {"enum": ["public", "player", "player_specific", "host", "owner", "author_offline"]},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local_ref"}},
        "payload": {"type": "object", "additionalProperties": false, "required": ["summary", "target_refs"], "properties": {"summary": {"type": "string", "minLength": 1, "maxLength": 4000}, "target_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}}}
      }
    }
  }
}
