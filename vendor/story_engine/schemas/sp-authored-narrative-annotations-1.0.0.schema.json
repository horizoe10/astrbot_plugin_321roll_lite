{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "body_sha256",
    "blocks"
  ],
  "properties": {
    "schema": {
      "const": "sp-authored-narrative-annotations/1.0.0"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "kind",
          "speaker",
          "mentions"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "paragraph",
              "npc_dialogue"
            ]
          },
          "speaker": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_ref",
                  "label"
                ],
                "properties": {
                  "source_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "mentions": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_ref",
                "label",
                "start",
                "end"
              ],
              "properties": {
                "source_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sp-authored-narrative-annotations/1.0.0"
}
