{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-resolution-rule-catalog-ir/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requirement_refs", "definitions", "modifier_source_catalog_sha256", "post_resolution_binding_sha256", "catalog_sha256"],
  "properties": {
    "schema": {"const": "se-resolution-rule-catalog-ir/1.0.0"},
    "requirement_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"}},
    "definitions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object"}},
    "modifier_source_catalog_sha256": {"$ref": "#/$defs/digest"},
    "post_resolution_binding_sha256": {"$ref": "#/$defs/digest"},
    "catalog_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
