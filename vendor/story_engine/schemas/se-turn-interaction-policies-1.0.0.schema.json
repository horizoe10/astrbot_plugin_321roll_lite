{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-turn-interaction-policies/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policies"],
  "properties": {
    "schema": {"const": "se-turn-interaction-policies/1.0.0"},
    "policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/policy"}}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$"},
    "mode": {"enum": ["choice_only", "dialogue_only", "hybrid"]},
    "phase": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_modes", "default_mode", "hybrid_submission_policy", "choice_cardinality", "dialogue_constraints", "ambiguity_policy", "transition_targets", "fallback_mode"],
      "properties": {
        "allowed_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/mode"}},
        "default_mode": {"$ref": "#/$defs/mode"},
        "hybrid_submission_policy": {"enum": [null, "one_of", "choice_with_optional_dialogue"]},
        "choice_cardinality": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 0, "maximum": 1}, "maximum": {"type": "integer", "minimum": 0, "maximum": 1}}},
        "dialogue_constraints": {"type": "object", "additionalProperties": false, "required": ["maximum_characters", "allow_empty", "allow_ooc"], "properties": {"maximum_characters": {"type": "integer", "minimum": 1, "maximum": 4000}, "allow_empty": {"const": false}, "allow_ooc": {"type": "boolean"}}},
        "ambiguity_policy": {"const": "needs_clarification"},
        "transition_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "fallback_mode": {"anyOf": [{"$ref": "#/$defs/mode"}, {"type": "null"}]}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_ref", "applicable_profiles", "phases", "locale_text_limits", "accessibility", "fallback", "conformance_cases"],
      "properties": {
        "policy_ref": {"$ref": "#/$defs/ref"},
        "applicable_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "phases": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/phase"}},
        "locale_text_limits": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 4000}},
        "accessibility": {"type": "object"},
        "fallback": {"type": "object", "additionalProperties": false, "required": ["web", "qq", "headless", "reserved_meta_commands"], "properties": {"web": {"$ref": "#/$defs/ref"}, "qq": {"$ref": "#/$defs/ref"}, "headless": {"$ref": "#/$defs/ref"}, "reserved_meta_commands": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}}}},
        "conformance_cases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
      }
    }
  }
}
