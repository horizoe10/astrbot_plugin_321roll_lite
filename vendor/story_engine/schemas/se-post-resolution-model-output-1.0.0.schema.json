{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-post-resolution-model-output/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["blocks", "proposals", "option_copy", "used_fact_refs", "used_receipt_refs", "used_capability_refs", "warnings"],
  "properties": {
    "blocks": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"enum": ["paragraph", "dialogue", "heading", "aside"]}, "text": {"type": "string", "minLength": 1, "maxLength": 360, "pattern": "^[^\\r\\n]+$"}}}},
    "proposals": {"type": "array", "maxItems": 64},
    "option_copy": {"type": "object", "additionalProperties": false, "required": ["status", "items"], "properties": {"status": {"enum": ["no_options", "frozen_options"]}, "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["local_ref", "text"], "properties": {"local_ref": {"$ref": "#/$defs/ref"}, "text": {"type": "string", "minLength": 1, "maxLength": 240}}}}}},
    "used_fact_refs": {"$ref": "#/$defs/refs"},
    "used_receipt_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "used_capability_refs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["base.narrative", "narrative.structured_output"]}},
    "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 240}}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
  }
}
