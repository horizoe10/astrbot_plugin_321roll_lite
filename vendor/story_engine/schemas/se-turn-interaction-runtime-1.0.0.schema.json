{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-turn-interaction-runtime/1.0.0",
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "choice": {"type": "object", "additionalProperties": false, "required": ["choice_ref", "label", "purpose", "cost", "risk", "limitations", "next_phase_ref", "allow_optional_dialogue"], "properties": {"choice_ref": {"$ref": "#/$defs/ref"}, "label": {"type": "string"}, "purpose": {"type": "string"}, "cost": {"type": "string"}, "risk": {"type": "string"}, "limitations": {"type": "string"}, "next_phase_ref": {"$ref": "#/$defs/ref"}, "allow_optional_dialogue": {"type": "boolean"}}},
    "dialogueIntent": {"type": "object", "additionalProperties": false, "required": ["intent_ref", "accepted_utterances", "next_phase_ref"], "properties": {"intent_ref": {"$ref": "#/$defs/ref"}, "accepted_utterances": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 400}}, "next_phase_ref": {"$ref": "#/$defs/ref"}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["schema", "interaction_revision", "policy_ref", "policy_sha256", "phase_ref", "mode", "hybrid_submission_policy", "choices", "choice_cardinality", "dialogue_constraints", "ambiguity_policy", "fallback_mode", "dialogue_intents", "available_input_capabilities", "actor_ref", "control_lease_ref", "action_roster_revision", "expected_session_revision", "fingerprint"], "properties": {"schema": {"const": "se-turn-interaction-snapshot/1.0.0"}, "interaction_revision": {"type": "integer", "minimum": 0}, "policy_ref": {"$ref": "#/$defs/ref"}, "policy_sha256": {"$ref": "#/$defs/hash"}, "phase_ref": {"$ref": "#/$defs/ref"}, "mode": {"enum": ["choice_only", "dialogue_only", "hybrid"]}, "hybrid_submission_policy": {"enum": [null, "one_of", "choice_with_optional_dialogue"]}, "choices": {"type": "array", "items": {"$ref": "#/$defs/choice"}}, "choice_cardinality": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 0, "maximum": 1}, "maximum": {"type": "integer", "minimum": 0, "maximum": 1}}}, "dialogue_constraints": {"type": "object", "additionalProperties": false, "required": ["maximum_characters", "allow_empty", "allow_ooc"], "properties": {"maximum_characters": {"type": "integer", "minimum": 1, "maximum": 4000}, "allow_empty": {"const": false}, "allow_ooc": {"type": "boolean"}}}, "ambiguity_policy": {"const": "needs_clarification"}, "fallback_mode": {"enum": [null, "choice_only", "dialogue_only", "hybrid"]}, "dialogue_intents": {"type": "array", "items": {"$ref": "#/$defs/dialogueIntent"}}, "available_input_capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["choice", "dialogue"]}}, "actor_ref": {"$ref": "#/$defs/ref"}, "control_lease_ref": {"$ref": "#/$defs/ref"}, "action_roster_revision": {"type": "integer", "minimum": 0}, "expected_session_revision": {"type": "integer", "minimum": 0}, "fingerprint": {"$ref": "#/$defs/hash"}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["schema", "kind", "expected_interaction_revision"], "properties": {"schema": {"const": "se-player-turn-input/1.0.0"}, "kind": {"enum": ["choice", "dialogue", "hybrid"]}, "expected_interaction_revision": {"type": "integer", "minimum": 0}, "choice_ref": {"$ref": "#/$defs/ref"}, "utterance": {"type": "string", "minLength": 1, "maxLength": 4000}, "locale": {"$ref": "#/$defs/ref"}, "client_input_ref": {"$ref": "#/$defs/ref"}}},
    "proposal": {"type": "object", "additionalProperties": false, "required": ["schema", "proposal_ref", "operation_ref", "kind", "consumed_input_digest", "source_interaction_revision", "selected_choice_ref", "resolved_intent_ref", "next_phase_ref", "next_mode", "clarification_question", "clarification_candidates", "choice_semantics", "warnings"], "properties": {"schema": {"const": "se-turn-interaction-proposal/1.0.0"}, "proposal_ref": {"$ref": "#/$defs/ref"}, "operation_ref": {"$ref": "#/$defs/ref"}, "kind": {"enum": ["advance", "clarification", "wait", "complete"]}, "consumed_input_digest": {"$ref": "#/$defs/hash"}, "source_interaction_revision": {"type": "integer", "minimum": 0}, "selected_choice_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "resolved_intent_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "next_phase_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "next_mode": {"enum": [null, "choice_only", "dialogue_only", "hybrid"]}, "clarification_question": {"type": ["string", "null"]}, "clarification_candidates": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "choice_semantics": {"type": "array", "items": {"$ref": "#/$defs/choice"}}, "warnings": {"type": "array", "items": {"type": "string"}}}}
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope", "snapshot", "player_input"],
  "properties": {"envelope": {"type": "object"}, "snapshot": {"$ref": "#/$defs/snapshot"}, "player_input": {"$ref": "#/$defs/input"}}
}
