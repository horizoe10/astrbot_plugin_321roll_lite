{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "se-resolution-check-runtime/1.0.0",
  "description": "Frozen proposal-only resolution snapshot/request/result family; platform owns difficulty, seed, roll, receipt and all commits.",
  "oneOf": [{"$ref": "#/$defs/snapshot"}, {"$ref": "#/$defs/request"}, {"$ref": "#/$defs/receipt"}, {"$ref": "#/$defs/proposal"}, {"$ref": "#/$defs/result"}],
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,127}$"}, "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "envelope": {"type": "object", "additionalProperties": false, "required": ["engine_contract_version", "operation_ref", "trace_ref", "idempotency_key", "request_fingerprint", "deadline_at", "session_ref", "expected_revision", "operation_type"], "properties": {"engine_contract_version": {"const": "story-engine-port/1.0.0"}, "operation_ref": {"$ref": "#/$defs/ref"}, "trace_ref": {"$ref": "#/$defs/ref"}, "idempotency_key": {"$ref": "#/$defs/ref"}, "request_fingerprint": {"$ref": "#/$defs/hash"}, "deadline_at": {"type": "string", "minLength": 1, "maxLength": 64}, "session_ref": {"$ref": "#/$defs/ref"}, "expected_revision": {"type": "integer", "minimum": 0}, "operation_type": {"const": "evaluate_resolution_check"}}},
    "problem": {"type": "object", "additionalProperties": false, "required": ["code", "failed_operation", "reason", "automatic_handling", "next_action", "retryable"], "properties": {"code": {"type": "string", "pattern": "^engine\\."}, "failed_operation": {"type": "string", "minLength": 1, "maxLength": 512}, "reason": {"type": "string", "minLength": 1, "maxLength": 512}, "automatic_handling": {"type": "string", "minLength": 1, "maxLength": 512}, "next_action": {"type": "string", "minLength": 1, "maxLength": 512}, "retryable": {"type": "boolean"}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["schema", "check_revision", "definition_ref", "definition_sha256", "actor_ref", "target_ref", "target_snapshot_sha256", "ability_ref", "skill_ref", "tool_ref", "difficulty_rating", "difficulty_receipt_ref", "difficulty_receipt_sha256", "host_confirmation_receipt_ref", "host_confirmation_receipt_sha256", "advantage_state", "modifier_receipt_refs", "assist_actor_refs", "assist_receipt_refs", "retry_count", "retry_cost_receipt_ref", "retry_cost_receipt_sha256", "seed_ref", "rule_revision", "expected_session_revision", "rule_capability_available", "fingerprint"], "properties": {"schema": {"const": "se-resolution-check-snapshot/1.0.0"}, "check_revision": {"type": "integer", "minimum": 0}, "definition_ref": {"$ref": "#/$defs/ref"}, "definition_sha256": {"$ref": "#/$defs/hash"}, "actor_ref": {"$ref": "#/$defs/ref"}, "target_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "target_snapshot_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "ability_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "skill_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "tool_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "difficulty_rating": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}, "difficulty_receipt_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "difficulty_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "host_confirmation_receipt_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "host_confirmation_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "advantage_state": {"enum": ["none", "advantage", "disadvantage"]}, "modifier_receipt_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "assist_actor_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "assist_receipt_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "retry_count": {"type": "integer", "minimum": 0}, "retry_cost_receipt_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "retry_cost_receipt_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}, "seed_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "rule_revision": {"type": "integer", "minimum": 0}, "expected_session_revision": {"type": "integer", "minimum": 0}, "rule_capability_available": {"type": "boolean"}, "fingerprint": {"$ref": "#/$defs/hash"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["schema", "receipt_ref", "definition_ref", "definition_sha256", "seed_ref", "rule_revision", "outcome", "degree", "total", "fingerprint"], "properties": {"schema": {"const": "se-resolution-check-rule-receipt/1.0.0"}, "receipt_ref": {"$ref": "#/$defs/ref"}, "definition_ref": {"$ref": "#/$defs/ref"}, "definition_sha256": {"$ref": "#/$defs/hash"}, "seed_ref": {"$ref": "#/$defs/ref"}, "rule_revision": {"type": "integer", "minimum": 0}, "outcome": {"enum": ["success", "failure"]}, "degree": {"$ref": "#/$defs/ref"}, "total": {"type": "integer"}, "fingerprint": {"$ref": "#/$defs/hash"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["schema", "envelope", "action", "snapshot", "rule_receipt"], "properties": {"schema": {"const": "se-resolution-check-evaluation/1.0.0"}, "envelope": {"$ref": "#/$defs/envelope"}, "action": {"enum": ["preview", "prepare_roll", "interpret_receipt"]}, "snapshot": {"$ref": "#/$defs/snapshot"}, "rule_receipt": {"anyOf": [{"$ref": "#/$defs/receipt"}, {"type": "null"}]}}},
    "proposal": {"type": "object", "additionalProperties": false, "required": ["schema", "proposal_ref", "operation_ref", "kind", "source_check_revision", "public_preview", "private_reconciliation", "deterministic_roll_input", "result_candidates", "interpreted_result", "used_receipt_refs", "warnings"], "properties": {"schema": {"const": "se-resolution-check-proposal/1.0.0"}, "proposal_ref": {"$ref": "#/$defs/ref"}, "operation_ref": {"$ref": "#/$defs/ref"}, "kind": {"enum": ["preview", "roll_request", "interpretation", "no_roll", "host_confirmation"]}, "source_check_revision": {"type": "integer", "minimum": 0}, "public_preview": {"type": "object"}, "private_reconciliation": {"type": "object"}, "deterministic_roll_input": {"type": ["object", "null"]}, "result_candidates": {"type": "array", "minItems": 2}, "interpreted_result": {"type": ["object", "null"]}, "used_receipt_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "warnings": {"type": "array", "items": {"type": "string"}}}, "oneOf": [{"properties": {"kind": {"const": "roll_request"}, "deterministic_roll_input": {"type": "object"}, "interpreted_result": {"type": "null"}}}, {"properties": {"kind": {"const": "interpretation"}, "deterministic_roll_input": {"type": "null"}, "interpreted_result": {"type": "object"}}}, {"properties": {"kind": {"enum": ["preview", "no_roll", "host_confirmation"]}, "deterministic_roll_input": {"type": "null"}, "interpreted_result": {"type": "null"}}}]},
    "result": {"type": "object", "additionalProperties": false, "required": ["schema", "operation_ref", "request_fingerprint", "expected_revision", "source_check_revision", "status", "proposal", "problems", "result_fingerprint"], "properties": {"schema": {"const": "se-resolution-check-result/1.0.0"}, "operation_ref": {"$ref": "#/$defs/ref"}, "request_fingerprint": {"$ref": "#/$defs/hash"}, "expected_revision": {"type": "integer", "minimum": 0}, "source_check_revision": {"type": "integer", "minimum": 0}, "status": {"enum": ["proposed", "no_roll", "needs_host_confirmation", "blocked", "cancelled", "timed_out"]}, "proposal": {"anyOf": [{"$ref": "#/$defs/proposal"}, {"type": "null"}]}, "problems": {"type": "array", "items": {"$ref": "#/$defs/problem"}}, "result_fingerprint": {"$ref": "#/$defs/hash"}}, "oneOf": [{"properties": {"status": {"const": "proposed"}, "proposal": {"allOf": [{"$ref": "#/$defs/proposal"}, {"properties": {"kind": {"enum": ["preview", "roll_request", "interpretation"]}}}]}, "problems": {"maxItems": 0}}}, {"properties": {"status": {"const": "no_roll"}, "proposal": {"allOf": [{"$ref": "#/$defs/proposal"}, {"properties": {"kind": {"const": "no_roll"}}}]}, "problems": {"maxItems": 0}}}, {"properties": {"status": {"const": "needs_host_confirmation"}, "proposal": {"allOf": [{"$ref": "#/$defs/proposal"}, {"properties": {"kind": {"const": "host_confirmation"}}}]}, "problems": {"maxItems": 0}}}, {"properties": {"status": {"enum": ["blocked", "cancelled", "timed_out"]}, "proposal": {"type": "null"}, "problems": {"minItems": 1}}}]}
  }
}
