{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "room_ref",
    "actor_ref",
    "event_ref",
    "checkpoint_ref",
    "room_revision",
    "actor_revision",
    "event_revision",
    "artifact_sha256",
    "facts",
    "difficulty_policy",
    "context_sha256",
    "schema",
    "policy_sha256",
    "room_action_policy",
    "utterance",
    "references",
    "candidates"
  ],
  "properties": {
    "room_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actor_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "event_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "checkpoint_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "room_revision": {
      "type": "integer",
      "minimum": 1
    },
    "actor_revision": {
      "type": "integer",
      "minimum": 1
    },
    "event_revision": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "facts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_ref",
          "kind",
          "text",
          "source_receipt_refs"
        ],
        "properties": {
          "fact_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "world_fact",
              "npc_statement",
              "player_declaration",
              "hypothesis"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "source_receipt_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "difficulty_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "rule_ref",
        "rule_version",
        "rule_sha256",
        "difficulties",
        "model_budget",
        "policy_sha256"
      ],
      "properties": {
        "schema": {
          "const": "se-pack-check-plan-options/1.0.0"
        },
        "rule_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rule_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rule_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "difficulties": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "model_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plan",
            "narrative"
          ],
          "properties": {
            "plan": {
              "const": 1
            },
            "narrative": {
              "const": 1
            }
          }
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "schema": {
      "const": "321roll-pack-dialogue-plan-context/1.0.0"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "room_action_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "revision",
        "mode",
        "hybrid_strategy"
      ],
      "properties": {
        "schema": {
          "const": "321roll-room-action-policy/1.0.0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "enum": [
            "choice_only",
            "dialogue_only",
            "hybrid"
          ]
        },
        "hybrid_strategy": {
          "enum": [
            null,
            "one_of",
            "critical_choices"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "hybrid"
              }
            }
          },
          "then": {
            "properties": {
              "hybrid_strategy": {
                "enum": [
                  "one_of",
                  "critical_choices"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "hybrid_strategy": {
                "type": "null"
              }
            }
          }
        }
      ],
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "utterance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "references": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_ref",
          "kind",
          "label",
          "description",
          "source_receipt_refs",
          "start",
          "end"
        ],
        "properties": {
          "entity_ref": {
            "type": "string",
            "pattern": "^entity\\.[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "person",
              "place",
              "item",
              "quest",
              "ability",
              "status"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 4000
          },
          "source_receipt_refs": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice_ref",
          "label",
          "purpose",
          "risk",
          "cost",
          "limitations",
          "check"
        ],
        "properties": {
          "choice_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "risk": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "cost": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "limitations": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "check": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "offer_ref",
                  "offer_sha256",
                  "definition_ref",
                  "definition_sha256",
                  "difficulty_source",
                  "fixed_rating",
                  "attribute_context"
                ],
                "properties": {
                  "offer_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "offer_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "definition_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "definition_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "difficulty_source": {
                    "enum": [
                      "fixed",
                      "host_confirm"
                    ]
                  },
                  "fixed_rating": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "attribute_context": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "schema",
                      "attributes",
                      "sources",
                      "action_source_ref",
                      "context_sha256"
                    ],
                    "properties": {
                      "schema": {
                        "const": "321roll-action-attribute-context/1.0.0"
                      },
                      "attributes": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "ref",
                            "label",
                            "value"
                          ],
                          "properties": {
                            "ref": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200,
                              "pattern": "\\S"
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200,
                              "pattern": "\\S"
                            },
                            "value": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100
                            }
                          }
                        }
                      },
                      "sources": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 32,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "source_ref",
                            "kind",
                            "label",
                            "text",
                            "source_sha256"
                          ],
                          "properties": {
                            "source_ref": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240,
                              "pattern": "\\S"
                            },
                            "kind": {
                              "enum": [
                                "action",
                                "profession",
                                "specialization",
                                "skill",
                                "attribute"
                              ]
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 240,
                              "pattern": "\\S"
                            },
                            "text": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 4000,
                              "pattern": "\\S"
                            },
                            "source_sha256": {
                              "type": "string",
                              "pattern": "^sha256:[0-9a-f]{64}$"
                            }
                          }
                        }
                      },
                      "action_source_ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240,
                        "pattern": "\\S"
                      },
                      "context_sha256": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    },
                    "$schema": "https://json-schema.org/draft/2020-12/schema"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://321roll.local/contracts/se-pack-dialogue-plan-context-1.0.0.schema.json"
}
