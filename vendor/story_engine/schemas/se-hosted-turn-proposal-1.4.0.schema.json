{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paragraphs",
    "facts",
    "npcs",
    "suggestions",
    "progress",
    "decision_node",
    "schema",
    "committed"
  ],
  "properties": {
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "minItems": 1,
      "maxItems": 8
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "subject_ref",
          "text"
        ],
        "properties": {
          "kind": {
            "enum": [
              "world_fact",
              "npc_statement",
              "player_declaration",
              "hypothesis"
            ]
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "minItems": 0,
      "maxItems": 8
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "npc_ref",
          "name",
          "description",
          "motivation"
        ],
        "properties": {
          "npc_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 84
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "motivation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "entity_ref": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "minItems": 0,
            "maxItems": 8
          }
        }
      },
      "minItems": 0,
      "maxItems": 4
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "minItems": 1,
      "maxItems": 4
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "goal"
      ],
      "properties": {
        "scene": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "description"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "goal": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "decision_node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "reason",
            "candidates"
          ],
          "properties": {
            "schema": {
              "const": "se-hosted-decision-node/1.0.0"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "candidates": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "rule",
                  "source_fact_refs",
                  "exit"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "rule": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "difficulty",
                      "failure_cost"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "narrative",
                          "check",
                          "recover"
                        ]
                      },
                      "difficulty": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "failure_cost": {
                        "enum": [
                          "",
                          "setback",
                          "harm"
                        ]
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "kind": {
                              "const": "check"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "difficulty": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 80
                            },
                            "failure_cost": {
                              "enum": [
                                "setback",
                                "harm"
                              ]
                            }
                          }
                        },
                        "else": {
                          "properties": {
                            "difficulty": {
                              "const": ""
                            },
                            "failure_cost": {
                              "const": ""
                            }
                          }
                        }
                      }
                    ]
                  },
                  "source_fact_refs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "exit": {
                    "type": "boolean"
                  }
                }
              },
              "contains": {
                "properties": {
                  "exit": {
                    "const": true
                  }
                },
                "required": [
                  "exit"
                ]
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "const": "se-hosted-turn-proposal/1.4.0"
    },
    "committed": {
      "const": false
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "maxItems": 8
    }
  }
}
