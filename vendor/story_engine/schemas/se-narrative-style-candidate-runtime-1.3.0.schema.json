{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-narrative-style-candidate-runtime/1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_candidate_schema",
    "coverage_schema",
    "openings_schema",
    "candidate_version",
    "installable",
    "locale",
    "default_profile_ref",
    "default_preset_ref",
    "source_style_sha256",
    "source_coverage_sha256",
    "source_openings_sha256",
    "requirement_refs",
    "paragraph_contract",
    "runtime_generation",
    "preset_catalog",
    "profile_irs",
    "adapter_source_map",
    "opening_bindings",
    "counts",
    "model_calls",
    "runtime_sha256"
  ],
  "properties": {
    "schema": {
      "const": "se-narrative-style-candidate-runtime/1.3.0"
    },
    "source_candidate_schema": {
      "const": "sp-narrative-style-profiles-candidate/0.2"
    },
    "coverage_schema": {
      "const": "sp-narrative-style-coverage-candidate/0.2"
    },
    "openings_schema": {
      "const": "thirteenth-seat.openings-routes/1"
    },
    "candidate_version": {
      "const": "unassigned"
    },
    "installable": {
      "const": false
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})+$"
    },
    "default_profile_ref": {
      "$ref": "#/$defs/ref"
    },
    "default_preset_ref": {
      "$ref": "#/$defs/preset"
    },
    "source_style_sha256": {
      "$ref": "#/$defs/digest"
    },
    "source_coverage_sha256": {
      "$ref": "#/$defs/digest"
    },
    "source_openings_sha256": {
      "$ref": "#/$defs/digest"
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "paragraph_contract": {
      "$ref": "#/$defs/paragraph_contract"
    },
    "runtime_generation": {
      "$ref": "#/$defs/runtime_generation"
    },
    "preset_catalog": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/preset_entry"
      }
    },
    "profile_irs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "https://schemas.party321.invalid/se-narrative-style-ir/1.0.0"
      }
    },
    "adapter_source_map": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/source_map"
      }
    },
    "opening_bindings": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/opening_binding"
      }
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "model_calls": {
      "const": 0
    },
    "runtime_sha256": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,159}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "preset": {
      "enum": [
        "dialogue_high",
        "dialogue_soft",
        "balanced",
        "description_soft",
        "description_high"
      ]
    },
    "phase": {
      "enum": [
        "cooperative",
        "private_parallel",
        "regroup",
        "public_conflict",
        "finale",
        "epilogue"
      ]
    },
    "audience": {
      "enum": [
        "public",
        "party",
        "actor",
        "dm",
        "admin",
        "author"
      ]
    },
    "source_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ir_ref",
        "source_path"
      ],
      "properties": {
        "ir_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 1
        },
        "maximum": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "paragraph_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure",
        "allowed_block_kinds",
        "required_block_fields",
        "ordinary_paragraph_visible_characters",
        "length_mode_paragraph_targets",
        "new_paragraph_triggers",
        "special_block_overflow",
        "short_dialogue_or_turn_sentence_may_be_below_target_min",
        "paragraph_boundaries_are_authoritative",
        "empty_lines_are_not_the_schema",
        "choices_or_resolution_results_may_not_be_embedded",
        "humanizer_may_reorder_merge_or_split_blocks"
      ],
      "properties": {
        "structure": {
          "const": "NarrativeDocument.blocks[]"
        },
        "allowed_block_kinds": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "paragraph",
              "dialogue",
              "heading",
              "aside",
              "letter",
              "declaration",
              "short_poem",
              "ritual"
            ]
          }
        },
        "required_block_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "block_ref",
              "kind",
              "order",
              "locale",
              "audience",
              "source_ref",
              "text_digest"
            ]
          }
        },
        "ordinary_paragraph_visible_characters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target_min",
            "target_max",
            "hard_max"
          ],
          "properties": {
            "target_min": {
              "const": 60
            },
            "target_max": {
              "const": 220
            },
            "hard_max": {
              "const": 360
            }
          }
        },
        "length_mode_paragraph_targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimal",
            "balanced",
            "epic"
          ],
          "properties": {
            "minimal": {
              "$ref": "#/$defs/range"
            },
            "balanced": {
              "$ref": "#/$defs/range"
            },
            "epic": {
              "$ref": "#/$defs/range"
            }
          }
        },
        "new_paragraph_triggers": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "special_block_overflow": {
          "const": "split_with_shared_group_ref"
        },
        "short_dialogue_or_turn_sentence_may_be_below_target_min": {
          "const": true
        },
        "paragraph_boundaries_are_authoritative": {
          "const": true
        },
        "empty_lines_are_not_the_schema": {
          "const": true
        },
        "choices_or_resolution_results_may_not_be_embedded": {
          "const": true
        },
        "humanizer_may_reorder_merge_or_split_blocks": {
          "const": false
        }
      }
    },
    "runtime_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration",
        "additional_polish_calls",
        "additional_humanizer_calls",
        "additional_segmentation_calls",
        "channel_specific_rewrite_calls",
        "web_qq_and_headless_project_same_committed_narrative",
        "additional_model_calls"
      ],
      "properties": {
        "integration": {
          "const": "existing_structured_primary_generation_call"
        },
        "additional_polish_calls": {
          "const": 0
        },
        "additional_humanizer_calls": {
          "const": 0
        },
        "additional_segmentation_calls": {
          "const": 0
        },
        "channel_specific_rewrite_calls": {
          "const": 0
        },
        "web_qq_and_headless_project_same_committed_narrative": {
          "const": true
        },
        "additional_model_calls": {
          "const": 0
        }
      }
    },
    "preset_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_ref",
        "player_name",
        "dialogue_weight",
        "description_weight",
        "directive",
        "prohibition"
      ],
      "properties": {
        "preset_ref": {
          "$ref": "#/$defs/preset"
        },
        "player_name": {
          "type": "string",
          "minLength": 1
        },
        "dialogue_weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "description_weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "directive": {
          "type": "string",
          "minLength": 1
        },
        "prohibition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "narrative_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_ref",
        "kind",
        "order",
        "locale",
        "audience",
        "source_ref",
        "text",
        "text_digest"
      ],
      "properties": {
        "block_ref": {
          "$ref": "#/$defs/ref"
        },
        "kind": {
          "const": "paragraph"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "text_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "narrative_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "opening_ref",
        "blocks",
        "paragraph_count",
        "outside_target_count",
        "hard_limit_violations",
        "document_sha256"
      ],
      "properties": {
        "schema": {
          "const": "se-narrative-opening-document/1.0.0"
        },
        "opening_ref": {
          "$ref": "#/$defs/ref"
        },
        "blocks": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/narrative_block"
          }
        },
        "paragraph_count": {
          "type": "integer",
          "minimum": 2
        },
        "outside_target_count": {
          "type": "integer",
          "minimum": 0
        },
        "hard_limit_violations": {
          "const": 0
        },
        "document_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "opening_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opening_ref",
        "title",
        "region",
        "source_body_sha256",
        "default_profile_ref",
        "allowed_profile_refs",
        "allowed_preset_refs",
        "sensory_anchors",
        "narrative_document"
      ],
      "properties": {
        "opening_ref": {
          "$ref": "#/$defs/ref"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "source_body_sha256": {
          "$ref": "#/$defs/digest"
        },
        "default_profile_ref": {
          "$ref": "#/$defs/ref"
        },
        "allowed_profile_refs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "allowed_preset_refs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/preset"
          }
        },
        "sensory_anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "narrative_document": {
          "anyOf": [
            {
              "$ref": "#/$defs/narrative_document"
            },
            {
              "$ref": "#/$defs/referenced_document"
            }
          ]
        },
        "event_narratives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event_narrative"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiles",
        "presets",
        "phase_variants",
        "style_slices",
        "source_openings",
        "covered_openings",
        "narrative_blocks"
      ],
      "properties": {
        "profiles": {
          "const": 3
        },
        "presets": {
          "const": 5
        },
        "phase_variants": {
          "const": 6
        },
        "style_slices": {
          "const": 90
        },
        "source_openings": {
          "const": 10
        },
        "covered_openings": {
          "const": 10
        },
        "narrative_blocks": {
          "type": "integer",
          "minimum": 20
        }
      }
    },
    "referenced_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_ref",
        "kind",
        "order",
        "locale",
        "audience",
        "source_ref",
        "text",
        "text_digest",
        "references",
        "speaker",
        "reference_status"
      ],
      "properties": {
        "block_ref": {
          "$ref": "#/$defs/ref"
        },
        "kind": {
          "enum": [
            "paragraph",
            "npc_dialogue",
            "npc_action"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "text_digest": {
          "$ref": "#/$defs/digest"
        },
        "references": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "source_ref",
              "label",
              "start",
              "end",
              "kind"
            ],
            "properties": {
              "schema": {
                "const": "se-authored-entity-reference/1.0.0"
              },
              "source_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "enum": [
                  "person",
                  "place",
                  "quest",
                  "status"
                ]
              }
            }
          }
        },
        "speaker": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema",
                "source_ref",
                "label",
                "kind"
              ],
              "properties": {
                "schema": {
                  "const": "se-authored-speaker/1.0.0"
                },
                "source_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "kind": {
                  "const": "person"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_status": {
          "enum": [
            "none",
            "resolved"
          ]
        }
      }
    },
    "referenced_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "opening_ref",
        "blocks",
        "paragraph_count",
        "outside_target_count",
        "hard_limit_violations",
        "document_sha256"
      ],
      "properties": {
        "schema": {
          "const": "se-narrative-opening-document/1.2.0"
        },
        "opening_ref": {
          "$ref": "#/$defs/ref"
        },
        "blocks": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/referenced_block"
          }
        },
        "paragraph_count": {
          "type": "integer",
          "minimum": 2
        },
        "outside_target_count": {
          "type": "integer",
          "minimum": 0
        },
        "hard_limit_violations": {
          "const": 0
        },
        "document_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "event_narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "opening_ref",
        "event_ref",
        "route_ref",
        "source_body_sha256",
        "blocks",
        "document_sha256"
      ],
      "properties": {
        "schema": {
          "const": "se-authored-event-narrative/1.1.0"
        },
        "opening_ref": {
          "$ref": "#/$defs/ref"
        },
        "event_ref": {
          "$ref": "#/$defs/ref"
        },
        "route_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_body_sha256": {
          "$ref": "#/$defs/digest"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/referenced_block"
          }
        },
        "document_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
