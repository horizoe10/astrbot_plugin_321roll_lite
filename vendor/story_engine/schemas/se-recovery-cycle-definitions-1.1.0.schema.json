{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://321.example/schemas/se-recovery-cycle-definitions-1.1.0.schema.json",
  "title": "SE recovery cycle author definitions 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "trusted_manifest", "source_bindings", "policies", "definitions"],
  "properties": {
    "schema": {"const": "se-recovery-cycle-definitions/1.1.0"},
    "trusted_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ref", "source_sha256", "real_sp_active_consumer"],
      "properties": {"source_ref": {"$ref": "#/$defs/ref"}, "source_sha256": {"$ref": "#/$defs/digest"}, "real_sp_active_consumer": {"const": false}}
    },
    "source_bindings": {"$ref": "#/$defs/sourceBindings"},
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["commit_owner", "progress_fact_owner", "terminal_owner", "unknown_policy", "ordinary_recovery_revives"],
      "properties": {"commit_owner": {"const": "platform"}, "progress_fact_owner": {"const": "platform"}, "terminal_owner": {"const": "platform"}, "unknown_policy": {"const": "reconcile_only"}, "ordinary_recovery_revives": {"const": false}}
    },
    "definitions": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/definition"}}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceBindings": {"type": "object", "additionalProperties": false, "required": ["resource_catalog_ref", "resource_catalog_sha256", "status_catalog_ref", "status_catalog_sha256", "vitality_contract_ref", "vitality_contract_sha256"], "properties": {"resource_catalog_ref": {"$ref": "#/$defs/ref"}, "resource_catalog_sha256": {"$ref": "#/$defs/digest"}, "status_catalog_ref": {"$ref": "#/$defs/ref"}, "status_catalog_sha256": {"$ref": "#/$defs/digest"}, "vitality_contract_ref": {"$ref": "#/$defs/ref"}, "vitality_contract_sha256": {"$ref": "#/$defs/digest"}}},
    "namedPositiveIntegers": {"type": "object", "minProperties": 1, "maxProperties": 5, "propertyNames": {"enum": ["vitality", "energy", "mana", "stress", "custom"]}, "additionalProperties": {"type": "integer", "minimum": 1}},
    "supplyCost": {"type": "object", "additionalProperties": false, "required": ["item_ref", "quantity", "inventory_revision"], "properties": {"item_ref": {"$ref": "#/$defs/ref"}, "quantity": {"type": "integer", "minimum": 1}, "inventory_revision": {"type": "integer", "minimum": 0}}},
    "resumePolicy": {"type": "object", "additionalProperties": false, "required": ["allowed", "requires_same_definition", "requires_committed_elapsed"], "properties": {"allowed": {"type": "boolean"}, "requires_same_definition": {"type": "boolean"}, "requires_committed_elapsed": {"type": "boolean"}}},
    "typedPolicies": {"type": "object", "additionalProperties": false, "required": ["resource", "status", "rest", "treat", "resupply", "allocate", "resume"], "properties": {
      "resource": {"type": "object", "additionalProperties": false, "required": ["kind", "resources"], "properties": {"kind": {"const": "exact_restore"}, "resources": {"type": "object", "minProperties": 1, "maxProperties": 5, "propertyNames": {"enum": ["vitality", "energy", "mana", "stress", "custom"]}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["exact_amount", "cap"], "properties": {"exact_amount": {"type": "integer", "minimum": 1}, "cap": {"type": "integer", "minimum": 1}}}}}},
      "status": {"type": "object", "additionalProperties": false, "required": ["kind", "status_refs", "allowed_classes"], "properties": {"kind": {"const": "eligible_remove"}, "status_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "allowed_classes": {"type": "array", "uniqueItems": true, "items": {"const": "recoverable"}}}},
      "rest": {"type": "object", "additionalProperties": false, "required": ["kind", "duration_seconds"], "properties": {"kind": {"const": "duration"}, "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 604800}}},
      "treat": {"type": "object", "additionalProperties": false, "required": ["kind", "receipt_required"], "properties": {"kind": {"const": "platform_receipt"}, "receipt_required": {"const": true}}},
      "resupply": {"type": "object", "additionalProperties": false, "required": ["kind", "costs"], "properties": {"kind": {"const": "exact_inventory_cost"}, "costs": {"type": "object", "propertyNames": {"$ref": "#/$defs/ref"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["quantity", "inventory_revision"], "properties": {"quantity": {"type": "integer", "minimum": 1}, "inventory_revision": {"type": "integer", "minimum": 0}}}}}},
      "allocate": {"type": "object", "additionalProperties": false, "required": ["kind", "engine_allocates"], "properties": {"kind": {"const": "platform_only"}, "engine_allocates": {"const": false}}},
      "resume": {"type": "object", "additionalProperties": false, "required": ["kind", "allowed", "requires_same_definition", "requires_committed_elapsed"], "properties": {"kind": {"const": "same_definition_committed_elapsed"}, "allowed": {"type": "boolean"}, "requires_same_definition": {"type": "boolean"}, "requires_committed_elapsed": {"type": "boolean"}}}
    }},
    "definition": {
      "type": "object", "additionalProperties": false,
      "required": ["recovery_ref", "label", "kind", "policy_version", "typed_policies", "allowed_phases", "interruption_policy", "hp0_policy", "zero_crossing_policy"],
      "properties": {
        "recovery_ref": {"$ref": "#/$defs/ref"}, "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "kind": {"enum": ["rest", "treat", "resupply", "allocate", "resume"]},
        "policy_version": {"const": "recovery-policy/1.1.0"}, "typed_policies": {"$ref": "#/$defs/typedPolicies"},
        "allowed_phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["idle", "started", "progressed", "interrupted", "completed", "cancelled"]}},
        "interruption_policy": {"enum": ["preserve_committed", "discard_uncommitted", "partial_by_receipt"]},
        "hp0_policy": {"const": "require_rescue_or_fate_receipt"},
        "zero_crossing_policy": {"const": "require_consent_and_rescue_or_fate_receipt"}
      },
      "oneOf": [
        {"properties": {"kind": {"const": "rest"}, "allowed_phases": {"contains": {"const": "idle"}}}},
        {"properties": {"kind": {"const": "treat"}, "typed_policies": {"properties": {"status": {"properties": {"status_refs": {"minItems": 1}}}}}}},
        {"properties": {"kind": {"const": "resupply"}, "typed_policies": {"properties": {"resupply": {"properties": {"costs": {"minProperties": 1}}}}}}},
        {"properties": {"kind": {"const": "allocate"}, "typed_policies": {"properties": {"resource": {"properties": {"resources": {"minProperties": 1}}}}}}},
        {"properties": {"kind": {"const": "resume"}, "typed_policies": {"properties": {"resume": {"properties": {"allowed": {"const": true}}}}}}}
      ],
      "allOf": [
        {"if": {"properties": {"kind": {"const": "rest"}}}, "then": {"properties": {"typed_policies": {"properties": {"rest": {"properties": {"kind": {"const": "duration"}}}}}}}},
        {"if": {"properties": {"kind": {"const": "treat"}}}, "then": {"properties": {"typed_policies": {"properties": {"treat": {"properties": {"receipt_required": {"const": true}}}}}}}},
        {"if": {"properties": {"kind": {"const": "resupply"}}}, "then": {"properties": {"typed_policies": {"properties": {"resupply": {"properties": {"kind": {"const": "exact_inventory_cost"}}}}}}}},
        {"if": {"properties": {"kind": {"const": "allocate"}}}, "then": {"properties": {"typed_policies": {"properties": {"allocate": {"properties": {"engine_allocates": {"const": false}}}}}}}},
        {"if": {"properties": {"kind": {"const": "resume"}}}, "then": {"properties": {"typed_policies": {"properties": {"resume": {"properties": {"kind": {"const": "same_definition_committed_elapsed"}}}}}}}}
      ]
    }
  }
}
