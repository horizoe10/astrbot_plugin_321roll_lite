{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-profile-registry/1.1.0",
  "title": "SE multi-version Profile Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_version", "revision", "selection_policy", "fingerprint", "profiles"],
  "properties": {
    "schema": {"const": "se-profile-registry/1.1.0"},
    "registry_version": {"const": "1.1.0"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "selection_policy": {"const": "exact_version_required"},
    "fingerprint": {"$ref": "#/$defs/hash"},
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "refList": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "version", "contract_sha256", "phase", "contract_owner", "evaluation_owner", "authority_owner", "execution_owner", "projection_owner", "late_result_policy", "allowed_scope_kinds", "required_capabilities", "allowed_capabilities", "min_checkpoints", "max_checkpoints", "required_profile_fields", "allowed_profile_fields", "budget_limits", "safety_boundaries"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
        "contract_sha256": {"$ref": "#/$defs/hash"},
        "phase": {"type": "string", "minLength": 1},
        "contract_owner": {"type": "string", "minLength": 1},
        "evaluation_owner": {"type": "string", "minLength": 1},
        "authority_owner": {"type": "string", "minLength": 1},
        "execution_owner": {"type": "string", "minLength": 1},
        "projection_owner": {"type": "string", "minLength": 1},
        "late_result_policy": {"type": "string", "minLength": 1},
        "allowed_scope_kinds": {"$ref": "#/$defs/refList"},
        "required_capabilities": {"$ref": "#/$defs/refList"},
        "allowed_capabilities": {"$ref": "#/$defs/refList"},
        "min_checkpoints": {"type": "integer", "minimum": 0},
        "max_checkpoints": {"type": "integer", "minimum": 0},
        "required_profile_fields": {"$ref": "#/$defs/refList"},
        "allowed_profile_fields": {"$ref": "#/$defs/refList"},
        "budget_limits": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "safety_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

