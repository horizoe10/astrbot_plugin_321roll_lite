{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief",
    "scene",
    "goal",
    "actor",
    "npcs",
    "facts",
    "recent_events",
    "action",
    "mechanical_receipt",
    "rules",
    "context_selection"
  ],
  "properties": {
    "brief": {
      "type": "object"
    },
    "scene": {
      "type": "object"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "actor": {
      "type": "object"
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_ref",
          "kind",
          "text"
        ],
        "properties": {
          "fact_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "world_fact",
              "npc_statement",
              "player_declaration",
              "hypothesis"
            ]
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "source_receipt_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "recent_events": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "mechanical_receipt": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "rules": {
      "type": "object"
    },
    "narrative_policy": {
      "type": "object"
    },
    "action_references": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0,
      "maxItems": 32
    },
    "entity_catalog": {
      "type": "object"
    },
    "decision_contract": {
      "const": "se-hosted-decision-node/1.0.0"
    },
    "selected_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_ref",
        "source_receipt_ref",
        "candidate"
      ],
      "properties": {
        "node_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_receipt_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "rule",
            "source_fact_refs",
            "exit"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "rule": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "difficulty",
                "failure_cost"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "narrative",
                    "check",
                    "recover"
                  ]
                },
                "difficulty": {
                  "type": "string",
                  "maxLength": 80
                },
                "failure_cost": {
                  "enum": [
                    "",
                    "setback",
                    "harm"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "check"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "difficulty": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "failure_cost": {
                        "enum": [
                          "setback",
                          "harm"
                        ]
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "difficulty": {
                        "const": ""
                      },
                      "failure_cost": {
                        "const": ""
                      }
                    }
                  }
                }
              ]
            },
            "source_fact_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "exit": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "attribute_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "attributes",
        "sources",
        "action_source_ref",
        "context_sha256"
      ],
      "properties": {
        "schema": {
          "const": "321roll-action-attribute-context/1.0.0"
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "label",
              "value"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_ref",
              "kind",
              "label",
              "text",
              "source_sha256"
            ],
            "properties": {
              "source_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              },
              "kind": {
                "enum": [
                  "action",
                  "profession",
                  "specialization",
                  "skill",
                  "attribute"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "\\S"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000,
                "pattern": "\\S"
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "action_source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "\\S"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema"
    },
    "context_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_count",
        "available_fact_count",
        "npc_count",
        "available_npc_count",
        "recent_event_count",
        "available_recent_count",
        "trimmed"
      ],
      "properties": {
        "fact_count": {
          "type": "integer",
          "minimum": 0
        },
        "available_fact_count": {
          "type": "integer",
          "minimum": 0
        },
        "npc_count": {
          "type": "integer",
          "minimum": 0
        },
        "available_npc_count": {
          "type": "integer",
          "minimum": 0
        },
        "recent_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "available_recent_count": {
          "type": "integer",
          "minimum": 0
        },
        "trimmed": {
          "type": "boolean"
        }
      }
    }
  }
}
