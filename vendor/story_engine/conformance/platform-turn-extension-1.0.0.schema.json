{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "se-platform-turn-extension/1.0.0",
  "title": "SE 1 ordinary-turn provider and readiness extension",
  "$defs": {
    "ProviderNarrativeProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative_document", "proposals", "used_fact_refs", "used_receipt_refs", "used_capability_refs", "warnings"],
      "properties": {
        "narrative_document": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocks"],
          "properties": {
            "blocks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {"text": {"type": "string", "minLength": 1}}
              }
            }
          }
        },
        "proposals": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {"type": {"type": "string", "minLength": 1}, "value": {"type": "object"}}
          }
        },
        "used_fact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "used_receipt_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "used_capability_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "DetailedReadiness": {
      "type": "object",
      "required": ["engine_runtime", "event", "narrative", "stream", "platform_bridge", "provider", "story_artifact"],
      "additionalProperties": false,
      "properties": {
        "engine_runtime": {"type": "object"},
        "event": {"type": "object"},
        "narrative": {"type": "object"},
        "stream": {"type": "object"},
        "platform_bridge": {"type": "object"},
        "provider": {"type": "object"},
        "story_artifact": {"type": "object"}
      }
    }
  }
}
