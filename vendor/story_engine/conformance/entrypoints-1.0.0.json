    "bridge_owner": "321_platform"
  },
  "remote": {
    "entry_point_group": "party321.story_engine.remote",
    "entry_point_name": "narrative",
    "callable": "story_engine.entrypoints:create_remote_story_engine",
    "dispatch_contract": "se-remote-dispatch/1.1.0",
    "methods": ["health", "describe", "readiness", "capabilities", "resolve_turn", "resolve_turn_stream", "evaluate_event"],
    "stream_dispatch_method": "dispatch_stream",
    "transport_auth_tls_owner": "321_platform",
    "bridge_owner": "321_platform"
  },
  "legacy_event_entrypoints": {
    "embedded": {
      "entry_point_group": "party321.story_engine.embedded",
      "entry_point_name": "event",
      "callable": "story_engine.entrypoints:create_embedded_event_engine"
    },
    "remote": {
      "entry_point_group": "party321.story_engine.remote",
      "entry_point_name": "event",
      "callable": "story_engine.entrypoints:create_remote_event_engine",
      "dispatch_contract": "se-remote-dispatch/1.0.0",
      "methods": ["health", "describe", "readiness", "capabilities", "evaluate_event"]
    }
  },
  "required_platform_features": [
    "authoritative-turn-commit/1",
    "event-gate-response/1",
    "event-visit-counts/1",
