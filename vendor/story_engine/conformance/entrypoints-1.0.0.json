  "required_provider_capabilities": ["structured_output"],
  "optional_provider_capabilities": ["streaming"],
  "authority_owner": "321_platform",
  "late_result_policy": "platform rejects cancelled, timed-out, late, fingerprint-mismatched or revision-mismatched results before commit"
